    margin-bottom: 15px;
    min-height: 40px; /* Altura mínima para alinear botones si el texto varía */
  }
 
  /* Ajuste para el botón */
  .plan-preview button {
    width: 100%; /* Botón ancho completo de la tarjeta */
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-button').forEach(button => {
      button.addEventListener('click', () => {
        const code = button.parentElement.nextElementSibling.querySelector(".source-code").innerText;
        navigator.clipboard.writeText(code).then(() => {
          button.innerHTML = "<i class='fa fa-check' aria-hidden='true'></i>&nbsp;Copied!";
          setTimeout(() => button.innerHTML = "<i class='fa fa-clipboard' aria-hidden='true'></i>&nbsp;Copy", 1500);
        });
      });
    });
        
    const formChangePlan = document.getElementById("formChangePlan");
    const modalChangePlan = document.getElementById("modalChangePlan");
    const confirmationFooter = document.getElementById("confirmationFooter");
 
    const formConfirmChangePlan = document.getElementById("formConfirmChangePlan");
    const btnCancelChangePlan = document.getElementById("btnCancelChangePlan");
    const btnConfirmChangePlan = document.getElementById("btnConfirmChangePlan");
 
    
 
 
    if (!modalChangePlan || !formConfirmChangePlan) return;
 
    /* Description: Close modalChangePlan when cancel */
    btnCancelChangePlan.addEventListener("click", () => {
      modalChangePlan.style.display = "none";
      confirmationFooter.style.display = "none";
    });
 
    /* Description: Close modalChangePlan when click out modal */
    modalChangePlan.addEventListener("click", e => {
      if (e.target === modalChangePlan) {
        modalChangePlan.style.display = "none";
        confirmationFooter.style.display = "none";
      }
    });
 
    /* Description: Close modalChangePlan when press ESC */
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        modalChangePlan.style.display = "none";
        confirmationFooter.style.display = "none";
      }
    });
 
 
    /* Description: Send request to change plan */
    formConfirmChangePlan.addEventListener("submit", function (e) {
      console.log("formConfirmChangePlan");
      e.preventDefault();
    });
 
    btnConfirmChangePlan.addEventListener("click", e => {
      e.preventDefault();
      // var respuesta = confirm("¿Acepta cambiar el plan?");
      const vaultValue = document.getElementById("vault-id").value;
      
      if(!vaultValue || vaultValue.trim() === ""){
        alert("Debe configurar una tarjeta de credito.");
        return;
      }
      
      if (confirm("¿Acepta cambiar el plan?")) {
        formConfirmChangePlan.submit();
      }
      
    });
 
  });
  
  /* Description: Function on click button "Seleccionar" */
  function preselectPlan(planId, planName, planSystemName) {
    document.getElementById('confirmationFooter').style.display = 'block';
    document.getElementById('lblSelectedPlanName').innerText = planName;
    document.getElementById('plan-id').value = planId;
    document.getElementById('plan-system-name').value = planSystemName;
    
  }
  
  /* Description: Open modalChangePlan */
  function openModalChangePlan() {
    modalChangePlan.style.display = "block";
  }
  
