    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 10000;
  }
 
  .custom-modal-box {
    background: #fff;
    width: 70%;
    margin: 10% auto;
    padding: 20px;
    border-radius: 6px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }
 /* 1. Contenedor de la lista: Lo convertimos en Flexbox */
  .plans-content {
    display: flex;
    flex-wrap: wrap; /* Permite que si no caben, bajen a la siguiente linea */
    gap: 15px;       /* Espacio entre tarjetas */
    border: none;    /* Quitar bordes por defecto del grupo */
    padding: 10px;
  }
 
  /* 2. Cada tarjeta individual (Item) */
  .list-group-item.plan-preview {
    flex: 1 1 calc(33.33% - 20px); /* Intenta ocupar 1/3 del ancho (3 columnas) */
